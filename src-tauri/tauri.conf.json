{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cg-analyze",
  "version": "0.1.0",
  "identifier": "com.cg-analyze.app",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/cg-analyze/browser"
  },
  "app": {
    "windows": [
      {
        "title": "CG Analyze",
        "width": 800,
        "height": 600,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/nabaztag.ico"
    ]
  }
}
